# Public site origin used for sitemap, canonical URLs, Open Graph, and JSON-LD.
# Baked into the client at Docker build time (compose build-arg / Dockerfile ARG).
#
# Local (npm run dev, or docker-compose.local.yml):
#   http://localhost:3000
#
# Server:
#   https://portal.tmytuned.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# FastAPI backend base URL (no trailing slash). Server-only — not baked into the client.
#
# Local (npm on the host):
#   http://localhost:8000
#
# Docker local (web container → API on the Docker host):
#   http://host.docker.internal:8000
#
# Server (recommended with be blue-green behind Nginx):
#   https://api.yourdomain.com
# Or host gateway to a stable host listener / active API port:
#   http://host.docker.internal:8001
API_BASE_URL=http://localhost:8000

# Auth cookies: Secure flag. Default = true when NODE_ENV=production.
# Set false only for plain-HTTP smoke tests (e.g. http://VPS_IP). Use true with HTTPS.
# AUTH_COOKIE_SECURE=false
